<div
  id="game-area"
  phx-hook="CursorTrack"
  class="relative w-screen h-screen bg-gray-900 overflow-hidden select-none font-sans"
>
  <div class="absolute top-6 left-6 z-40 pointer-events-auto flex flex-col gap-2 max-h-[50vh]">
    <div class="bg-black/50 backdrop-blur-md border border-white/10 rounded-xl shadow-lg overflow-hidden flex flex-col w-[260px]">
      <div class="px-4 py-3 border-b border-white/10 flex items-center justify-between bg-white/5">
        <div class="flex items-center gap-2 text-white font-bold text-sm">
          <div class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_5px_lime]"></div>
          <span>Online Users ({length(@leaderboard)})</span>
        </div>
      </div>

      <div
        class="overflow-y-auto overflow-x-hidden p-2 space-y-1 custom-scrollbar"
        style="max-height: 300px;"
      >
        <%= if @leaderboard == [] do %>
          <div class="text-gray-500 text-xs text-center py-4 italic">
            No players joined yet...
          </div>
        <% else %>
          <%= for {user, index} <- Enum.with_index(@leaderboard) do %>
            <div class={"flex items-center gap-2 p-2 rounded-lg transition-colors " <> (if user.id == @my_id, do: "bg-white/10 border border-white/20", else: "hover:bg-white/5")}>
              <div class={"w-5 text-center font-mono font-bold text-xs " <> (case index do 0 -> "text-yellow-400"; 1 -> "text-gray-300"; 2 -> "text-orange-400"; _ -> "text-gray-500" end)}>
                {index + 1}
              </div>

              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5 text-xs text-white">
                  <span>{user.country}</span>
                  <span class="truncate font-medium" style={"color: #{user.color}"}>
                    {user.name}
                  </span>
                  <%= if user.id == @my_id do %>
                    <span class="text-[10px] bg-purple-500/30 text-purple-200 px-1 rounded">
                      ME
                    </span>
                  <% end %>
                </div>
                <div class="flex items-center justify-between mt-0.5 text-[10px] text-gray-400 font-mono">
                  <span class="flex items-center gap-0.5">
                    <span class="text-red-400/80">⚔️</span>
                    {Number.Delimit.number_to_delimited(user.total_damage, precision: 0)}
                  </span>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="absolute top-6 right-6 z-50 flex flex-col items-end gap-3 pointer-events-auto">
    <%= if @joined? do %>
      <div class="flex flex-col bg-black/60 backdrop-blur-md border border-white/10 rounded-2xl shadow-xl animate-in fade-in slide-in-from-top-4 overflow-hidden min-w-[200px]">
        <div class="flex items-center gap-3 px-5 py-3 border-b border-white/5 bg-white/5">
          <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse shadow-[0_0_8px_rgba(34,197,94,0.6)]">
          </div>
          <span class="text-lg">{@my_country}</span>
          <span class="text-white font-bold text-sm tracking-wide truncate max-w-[120px]">
            {@my_name}
          </span>
        </div>

        <div class="px-5 py-3 space-y-2">
          <div class="flex items-center justify-between gap-4 text-xs">
            <span class="text-gray-400 flex items-center gap-1">⚔️ Damage</span>
            <span class="text-red-400 font-mono font-bold text-sm">
              {Number.Delimit.number_to_delimited(@my_damage, precision: 0)}
            </span>
          </div>
        </div>
      </div>

      <button
        phx-click="logout"
        class="bg-red-500/80 hover:bg-red-600 text-white text-xs font-bold px-4 py-2 rounded-full backdrop-blur-md shadow-lg transition-all hover:scale-105 flex items-center gap-2 group border border-red-400/30"
      >
        <span>🚪 Logout</span>
      </button>
    <% end %>
  </div>

  <%= if !@joined? do %>
    <div class="absolute inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm animate-in fade-in duration-500">
      <div class="bg-gray-800 p-8 rounded-2xl shadow-2xl w-full max-w-md border border-gray-700 relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-purple-500 via-pink-500 to-red-500">
        </div>
        <h2 class="text-3xl font-bold text-white mb-6 text-center bg-gradient-to-r from-purple-400 to-pink-600 bg-clip-text text-transparent">
          Join Cursor Party
        </h2>
        <.form for={@form} phx-submit="join" class="space-y-6">
          <div class="space-y-2">
            <label class="block text-sm font-medium text-gray-300">Display Name</label>
            <input
              type="text"
              name="name"
              class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent text-white placeholder-gray-500 outline-none transition-all"
              placeholder="Enter your name (3-20 chars)"
              required
              minlength="3"
              maxlength="20"
              autocomplete="off"
            />
          </div>
          <div class="space-y-2">
            <label class="block text-sm font-medium text-gray-300">Country</label>
            <select
              name="country"
              class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent text-white outline-none appearance-none cursor-pointer"
            >
              <option value="KR">🇰🇷 Korea, Republic of</option>
              <option value="US">🇺🇸 United States</option>
              <option value="JP">🇯🇵 Japan</option>
              <option value="CN">🇨🇳 China</option>
              <option value="GB">🇬🇧 United Kingdom</option>
              <option value="FR">🇫🇷 France</option>
              <option value="DE">🇩🇪 Germany</option>
              <option value="CA">🇨🇦 Canada</option>
              <option value="AU">🇦🇺 Australia</option>
              <option value="BR">🇧🇷 Brazil</option>
            </select>
          </div>
          <button
            type="submit"
            class="w-full py-3.5 px-4 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-bold rounded-lg shadow-lg transform transition-all active:scale-95 flex items-center justify-center gap-2 group"
          >
            <span>Start Adventure</span>
            <svg
              class="w-5 h-5 group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"
              >
              </path>
            </svg>
          </button>
        </.form>
      </div>
    </div>
  <% end %>

  <%= if @winner do %>
    <div class="absolute inset-0 z-50 flex flex-col items-center justify-center bg-black/70 animate-fade-in pointer-events-none">
      <div class="text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 via-orange-500 to-red-500 animate-bounce mb-4 drop-shadow-[0_0_15px_rgba(255,215,0,0.5)]">
        BOSS DEFEATED!
      </div>
      <div class="text-3xl text-white font-bold animate-pulse">
        MVP: <span class="text-yellow-400">{@winner}</span>
      </div>
      <div class="mt-8 text-xl text-gray-400">
        Refresh to play again
      </div>
    </div>
  <% end %>

  <% boss_style = get_boss_style(@boss_level) %>

  <div
    id="boss-target"
    phx-hook="BossEffect"
    phx-click="hit-boss"
    class="absolute transform -translate-x-1/2 -translate-y-1/2 cursor-pointer z-20 group"
    style="top: 50%; left: 50%; width: 250px; height: 250px;"
  >
    <div class={"w-full h-full bg-gradient-to-br #{boss_style.color} rounded-full shadow-[0_0_60px_rgba(0,0,0,0.6)] flex flex-col items-center justify-center text-white font-bold border-4 #{boss_style.border} group-hover:scale-105 transition-all duration-200 relative overflow-hidden"}>
      <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>

      <div class="absolute top-8 px-2 py-0.5 bg-black/50 rounded text-[10px] font-mono border border-white/10 text-yellow-300">
        Lv.{@boss_level}
      </div>

      <%= if boss_style.emoji == "slime" do %>
        <span class="text-4xl mb-1 drop-shadow-md z-10 select-none">👹</span>
      <% else %>
        <span class="text-5xl mb-1 drop-shadow-md z-10 select-none">{boss_style.emoji}</span>
      <% end %>

      <span class="text-xs text-gray-200 opacity-80 z-10 font-mono tracking-widest mb-1">
        {boss_style.name}
      </span>

      <div class="text-lg bg-black/40 px-3 py-1 rounded-full backdrop-blur-sm z-10 border border-white/10 font-mono">
        HP: {Number.Delimit.number_to_delimited(@boss_hp, precision: 0)}
      </div>

      <svg
        class="absolute inset-0 w-full h-full -rotate-90 opacity-30 pointer-events-none"
        viewBox="0 0 100 100"
      >
        <% max_hp = @boss_level * 2000 %>
        <circle
          cx="50"
          cy="50"
          r="48"
          fill="none"
          stroke="white"
          stroke-width="2"
          stroke-dasharray="301.59"
          stroke-dashoffset={301.59 * (1 - @boss_hp / max_hp)}
          class="transition-all duration-300 ease-out"
        />
      </svg>
    </div>
  </div>

  <%= for cursor <- @cursors do %>
    <%= if cursor.id != @my_id do %>
      <div
        class="absolute top-0 left-0 transition-all duration-[50ms] ease-out z-30 pointer-events-none will-change-transform"
        style={"transform: translate3d(#{cursor.x}vw, #{cursor.y}vh, 0);"}
      >
        <div class="relative group">
          <svg
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill={cursor.color}
            stroke="white"
            stroke-width="1.5"
            class="drop-shadow-lg transform -translate-x-[2px] -translate-y-[2px]"
          >
            <path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z" stroke-linejoin="round" />
          </svg>
          <div class="absolute top-5 left-4 flex items-center gap-1.5 bg-gray-900/90 text-white text-[11px] px-2.5 py-1 rounded-full shadow-xl whitespace-nowrap backdrop-blur-md border border-white/10 transform transition-all group-hover:scale-105 origin-top-left">
            <span class="text-base leading-none">{cursor[:country] || "🏳️"}</span>
            <span class="font-bold tracking-wide text-gray-100">{cursor[:name] || "User"}</span>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

  <div class="absolute bottom-6 left-6 z-10 flex flex-col gap-2">
    <div class="bg-black/50 backdrop-blur-md p-4 rounded-xl border border-white/10 text-gray-300 shadow-lg max-w-xs transition-opacity hover:opacity-100 opacity-60 hover:border-white/30">
      <div class="font-bold text-white mb-2 flex items-center gap-2 border-b border-white/10 pb-2">
        <span>💡 How to Play</span>
      </div>
      <ul class="text-sm space-y-1.5 list-disc list-inside opacity-90">
        <li>Move cursor to interact</li>
        <li>Click BOSS: <span class="text-red-400 font-bold">-1 HP</span></li>
        <li>Last Hit: <span class="text-yellow-400 font-bold">MVP 👑</span></li>
      </ul>
    </div>
  </div>

  <div class="absolute bottom-6 right-6 z-10 flex flex-col items-end gap-3">
    <button
      id="sound-btn"
      phx-hook="SoundControl"
      phx-update="ignore"
      class="bg-black/50 hover:bg-black/80 text-white p-3 rounded-full backdrop-blur-md border border-white/10 transition-all hover:scale-110 hover:border-white/30 mb-2"
      title="Toggle Sound"
    >
      <svg class="w-5 h-5 icon-on" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
        >
        </path>
      </svg>

      <svg class="w-5 h-5 icon-off hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z m-2 2l17-17"
        >
        </path>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"
        >
        </path>
      </svg>
    </button>

    <div class="flex items-center gap-3">
      <a
        href="https://github.com/jidohyun/cursor-party"
        target="_blank"
        class="bg-black/50 hover:bg-black/80 text-white p-3 rounded-full backdrop-blur-md border border-white/10 transition-all hover:scale-110 hover:border-white/30 group"
        title="View Source Code"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            clip-rule="evenodd"
          >
          </path>
        </svg>
      </a>

      <a
        href="https://velog.io/@do-hyun123/posts"
        target="_blank"
        class="bg-black/50 hover:bg-black/80 text-white p-3 rounded-full backdrop-blur-md border border-white/10 transition-all hover:scale-110 hover:border-white/30 group"
        title="Visit My Blog"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
          >
          </path>
        </svg>
      </a>
    </div>

    <div class="text-right">
      <div class="text-gray-500 text-[10px] font-mono mb-0.5">
        Ver 1.4.1 • Sound Control
      </div>
      <div class="text-gray-400 text-xs font-medium bg-black/30 px-2 py-1 rounded backdrop-blur-sm border border-white/5">
        Powered by <span class="text-purple-400">Elixir</span>
        & <span class="text-orange-400">Phoenix LiveView</span>
      </div>
    </div>
  </div>
</div>

<%= if @alert_msg do %>
  <div class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/70 animate-in fade-in duration-300">
    <div class="bg-red-600 text-white p-8 rounded-2xl shadow-2xl transform scale-110 text-center border-4 border-yellow-400">
      <div class="text-6xl mb-4">🚨</div>
      <h2 class="text-3xl font-black mb-4 whitespace-pre-wrap leading-relaxed">{@alert_msg}</h2>
      <p class="text-sm opacity-80 mt-4">(매크로 방지 시스템 작동 중)</p>
    </div>
  </div>
<% end %>

<%= if @banned_until do %>
  <div class="fixed bottom-0 left-0 w-full bg-gray-900 text-red-500 font-bold text-center py-4 z-50 text-xl border-t-4 border-red-500">
    ⛔ 1분간 공격이 금지되었습니다! (손가락 식히는 중...)
  </div>
<% end %>
